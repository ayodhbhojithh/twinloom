# Cloudinary. `.env*` is gitignored, so none of this reaches the repository.
#
# The first two are public by design: they are sent to the browser so it can
# post a file straight to Cloudinary. The last two never leave the server - the
# secret signs each upload inside the route handler and is not in any bundle.
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME=rjalmo09
NEXT_PUBLIC_CLOUDINARY_UPLOAD_PRESET=ml_default
CLOUDINARY_API_KEY=623942932156551
CLOUDINARY_API_SECRET=yG6CDE4nUZs4ba_OTVF8kZ68RLM

# Where scoping attachments land. One folder per desk under this.
CLOUDINARY_FOLDER=twinloom/scoping

# Google Workspace: the diary the meetings go into, and the account the site
# sends from. One service account with domain-wide delegation, impersonating
# the mailbox below - that impersonation is what lets it invite attendees at
# all, and what makes the confirmation come from an address people recognise.
#
# From the service account's JSON key: `client_email` and `private_key`. Keep
# the 
 sequences in the key exactly as they appear in the file.
